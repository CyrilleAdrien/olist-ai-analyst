# Copy this file to .env and adjust the values. .env is never committed.

# Olist warehouse (the PostgreSQL started by the Olist-Analytics project)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=olist

# Read-only role used by the agent, created by `make role`
AGENT_DB_USER=olist_agent
AGENT_DB_PASSWORD=change_me

# Admin account of the warehouse, only used by `make role`
POSTGRES_USER=olist
POSTGRES_PASSWORD=change_me

# LLM provider: ollama (default, free and local), groq, anthropic or openai
LLM_PROVIDER=ollama
# Leave empty to use the provider's default (ollama: qwen2.5-coder:7b, groq: llama-3.3-70b-versatile)
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# Only needed for the matching provider
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
